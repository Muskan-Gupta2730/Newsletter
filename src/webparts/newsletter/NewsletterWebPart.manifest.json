{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "568d62fb-ac31-4f04-bd01-d787224f6fb4",
  "alias": "NewsletterWebPart",
  "componentType": "WebPart",

  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70",
    "group": { "default": "Advanced" },
    "title": { "default": "CustomNewsletter" },
    "description": { "default": "Shows the latest spotlight news posts from your site as cards, with each post's category, published date and a link to the full story." },
    "officeFabricIconFontName": "News",
    "properties": {
      "siteUrl": "",
      "spotlightColumn": "IsSpotlight",
      "categoryColumn": "NewsCategory",
      "itemCount": 3,
      "title": "Spotlight",
      "subtitle": "News from around Sirva",
      "rightLabel": "This week"
    }
  }]
}